# ==============================================================================
# Workspace Intelligence Agent (WIA) - Environment Configuration Template
# Copy this file to '.env' and fill in your respective API keys and settings.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM Provider Configuration
# ------------------------------------------------------------------------------
# Choose provider: 'auto', 'gemini', 'openai', 'anthropic', 'nvidia', or 'heuristic'
# When set to 'auto', WIA automatically detects and uses the first available API key.
# If no keys are provided, WIA gracefully uses its local heuristic fallback generator.
DEFAULT_LLM_PROVIDER=auto

# Google Gemini API Key (Recommended for fast & accurate code understanding)
# Get key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Supports GPT-4o / GPT-4o-mini)
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (Supports Claude 3.5 Sonnet)
# Get key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# NVIDIA API Key (Supports Nemotron-4-340B-Instruct)
# Get key from: https://build.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# ------------------------------------------------------------------------------
# 2. Database & Storage Configuration
# ------------------------------------------------------------------------------
# PostgreSQL Database URL (Leave empty or commented out to use local SQLite wia.db)
# Example PostgreSQL: postgresql://postgres:postgrespassword@localhost:5432/wia_db
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. Vector Embeddings & RAG Configuration
# ------------------------------------------------------------------------------
# SentenceTransformers embedding model name
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# 4. Local Engine Daemon & API Server
# ------------------------------------------------------------------------------
WIA_HOST=127.0.0.1
WIA_PORT=8000
WIA_LOG_LEVEL=INFO
