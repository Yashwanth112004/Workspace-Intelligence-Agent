# ==============================================================================
# Workspace Intelligence Agent (WIA) - Environment Configuration
# ==============================================================================

# Primary LLM Provider: NVIDIA NIM (NeMo Inference Microservices)
DEFAULT_LLM_PROVIDER=nvidia
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-70b-instruct
# Optional NIM Embedding Model:
# NVIDIA_NIM_EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5

# Alternative LLM Providers (Optional fallback)
# OPENAI_API_KEY=your_openai_key_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
# GEMINI_API_KEY=your_gemini_key_here

# Database Configuration (Defaults to local SQLite if omitted)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/wia_db

# Local Vector Embedding Model (SentenceTransformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Server Configuration
WIA_HOST=127.0.0.1
WIA_PORT=8000
WIA_LOG_LEVEL=INFO
