{
  "name": "wia-agent",
  "displayName": "Workspace Intelligence Agent (WIA)",
  "description": "AI-Powered Code Intelligence, Architecture Map, Symbol Impact CodeLens, and Laya Decision Agent for VS Code",
  "version": "0.1.1",
  "publisher": "wia-agent",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Other",
    "Machine Learning"
  ],
  "keywords": [
    "code intelligence",
    "architecture",
    "codelens",
    "refactoring",
    "impact analysis",
    "ast",
    "agent",
    "laya"
  ],
  "main": "./out/extension.js",
  "icon": "resources/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Yashwanth112004/Workspace-Intelligence-Agent.git"
  },
  "activationEvents": [
    "onStartupFinished",
    "onView:wia-agent-view",
    "onView:wia-architecture",
    "onView:wia-symbols",
    "onView:wia-dependencies",
    "onCommand:wia.openAgent",
    "onCommand:wia.openChat",
    "onCommand:wia.showArchitecturePanel",
    "onCommand:wia.showImpactPanel"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wia-container",
          "title": "Workspace Intelligence Agent",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "wia-container": [
        {
          "type": "webview",
          "id": "wia-agent-view",
          "name": "🤖 WIA Agent & Chat"
        },
        {
          "id": "wia-architecture",
          "name": "🏛️ Architecture & Subsystems"
        },
        {
          "id": "wia-symbols",
          "name": "🔍 AST Symbol Explorer"
        },
        {
          "id": "wia-dependencies",
          "name": "📦 Dependencies & Imports"
        }
      ]
    },
    "commands": [
      {
        "command": "wia.openAgent",
        "title": "WIA: Open Workspace Intelligence Agent",
        "category": "WIA"
      },
      {
        "command": "wia.openChat",
        "title": "WIA: Open AI Agent Chat",
        "category": "WIA"
      },
      {
        "command": "wia.scanWorkspace",
        "title": "WIA: Scan & Ingest Workspace",
        "category": "WIA"
      },
      {
        "command": "wia.architecture",
        "title": "WIA: Show Architecture Map",
        "category": "WIA"
      },
      {
        "command": "wia.showArchitecturePanel",
        "title": "WIA: Open Visual Architecture Map",
        "category": "WIA"
      },
      {
        "command": "wia.explainArchitecture",
        "title": "WIA: Explain Code Architecture",
        "category": "WIA"
      },
      {
        "command": "wia.deps",
        "title": "WIA: Analyze Dependencies & Conflicts",
        "category": "WIA"
      },
      {
        "command": "wia.status",
        "title": "WIA: Show Workspace Status",
        "category": "WIA"
      },
      {
        "command": "wia.doctor",
        "title": "WIA: Run Environment Diagnostics (Doctor)",
        "category": "WIA"
      },
      {
        "command": "wia.fixEnvironment",
        "title": "WIA: Repair Environment & Dependencies",
        "category": "WIA"
      },
      {
        "command": "wia.summary",
        "title": "WIA: Generate Codebase Intelligence Summary",
        "category": "WIA"
      },
      {
        "command": "wia.files",
        "title": "WIA: List Indexed Files",
        "category": "WIA"
      },
      {
        "command": "wia.info",
        "title": "WIA: Tech Stack & Language Info",
        "category": "WIA"
      },
      {
        "command": "wia.search",
        "title": "WIA: Search Symbols & Files",
        "category": "WIA"
      },
      {
        "command": "wia.explainSymbol",
        "title": "WIA: Explain File or Symbol",
        "category": "WIA"
      },
      {
        "command": "wia.impact",
        "title": "WIA: Analyze Change Impact",
        "category": "WIA"
      },
      {
        "command": "wia.showImpactPanel",
        "title": "WIA: Open Change Impact Inspector",
        "category": "WIA"
      },
      {
        "command": "wia.analyzeImpactForSymbol",
        "title": "WIA: Analyze Impact for Symbol",
        "category": "WIA"
      },
      {
        "command": "wia.flow",
        "title": "WIA: Trace Call Flow",
        "category": "WIA"
      },
      {
        "command": "wia.traceFlowForSymbol",
        "title": "WIA: Trace Flow for Symbol",
        "category": "WIA"
      },
      {
        "command": "wia.diff",
        "title": "WIA: Git Diff & Symbol Impact",
        "category": "WIA"
      },
      {
        "command": "wia.gitHotspots",
        "title": "WIA: Git Commit Churn Hotspots",
        "category": "WIA"
      },
      {
        "command": "wia.securityScan",
        "title": "WIA: Scan Workspace for Secrets & Security",
        "category": "WIA"
      },
      {
        "command": "wia.generateReport",
        "title": "WIA: Generate HTML Intelligence Report",
        "category": "WIA"
      },
      {
        "command": "wia.runProject",
        "title": "WIA: Run Project Development Server",
        "category": "WIA"
      },
      {
        "command": "wia.runTests",
        "title": "WIA: Run Workspace Test Suite",
        "category": "WIA"
      },
      {
        "command": "wia.buildProject",
        "title": "WIA: Build / Compile Project",
        "category": "WIA"
      },
      {
        "command": "wia.config",
        "title": "WIA: Configure AI Provider & Settings",
        "category": "WIA"
      },
      {
        "command": "wia.refreshViews",
        "title": "WIA: Refresh Knowledge Views",
        "category": "WIA",
        "icon": "$(refresh)"
      },
      {
        "command": "wia.startDaemon",
        "title": "WIA: Start WIA Engine Daemon",
        "category": "WIA"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "wia.showImpactPanel",
          "group": "wia@1"
        },
        {
          "command": "wia.explainArchitecture",
          "group": "wia@2"
        }
      ],
      "view/title": [
        {
          "command": "wia.refreshViews",
          "when": "view == wia-architecture || view == wia-symbols || view == wia-dependencies",
          "group": "navigation"
        },
        {
          "command": "wia.scanWorkspace",
          "when": "view == wia-architecture",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Workspace Intelligence Agent",
      "properties": {
        "wia.provider": {
          "type": "string",
          "default": "nvidia",
          "enum": ["openrouter", "nvidia", "openai", "anthropic", "gemini", "local"],
          "description": "AI reasoning provider used for WIA explanations"
        },
        "wia.model": {
          "type": "string",
          "default": "meta/llama-3.1-70b-instruct",
          "description": "Model identifier for AI reasoning"
        },
        "wia.apiBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Base URL of the local WIA Engine Daemon API"
        },
        "wia.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Enable in-editor WIA CodeLens showing symbol impact, caller counts, and execution trace flow"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "node ./out/test/runAllTests.js",
    "package": "npx @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.3.0"
  }
}
